---
import Layout from '../layouts/BlogPost.astro';
import { Content } from '../content/about.md';
---

<style>
	.profile {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.profile img {
		border-radius: 50%;
	}
	.name {
		font-size: 1.5rem;
		font-weight: bold;
	}
</style>

<Layout
	title="About"
	description="hiroebe について"
>
	<div class="profile">
		<img src="/avatar.png" alt="avatar" width="128" height="128" />
		<span class="name">hiroebe</span>
	</div>
	<Content />
</Layout>
